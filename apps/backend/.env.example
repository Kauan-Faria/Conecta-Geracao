# =============================================================================
# Conecta Geração — Backend (.env.example)
# Copie para .env e preencha os valores. Nunca commite o .env real.
# =============================================================================

# --- Database (Supabase Postgres / Prisma) ---
DATABASE_URL=
DIRECT_URL=
# Opcional: shadow DB para `prisma migrate dev`
SHADOW_DATABASE_URL=

# --- Server ---
PORT=3000

# --- Firebase Auth (validação de ID token na API) ---
FIREBASE_PROJECT_ID=conecta-geracao

# --- LLM (assistente conversacional) ---
GEMINI_API_KEY=
# Opcional; default: gemini-3.5-flash
GEMINI_MODEL=

# --- Maps (bolt 011 — Google Maps Platform via proxy NestJS) ---
# Chave única para Geocoding API, Places API (New) e Routes API
GOOGLEMAPS_API_KEY=
MAPS_HTTP_TIMEOUT_MS=25000
MAPS_DEFAULT_RADIUS_KM=5
MAPS_MAX_RADIUS_KM=10
# Opcional
MAPS_USER_AGENT=ConectaGeracao/1.0 (contact@conectageracao.app)

# --- Push notifications (bolts 016–018) ---
# Habilitar envio real via FCM Admin SDK (false = no-op provider)
FCM_ENABLED=false
NOTIFICATION_INACTIVITY_HOURS=24
NOTIFICATION_REMINDER_COOLDOWN_HOURS=24
NOTIFICATION_JOB_BATCH_LIMIT=500
NOTIFICATION_TIP_WEEKLY_DAYS=7
NOTIFICATION_CAMPAIGN_BATCH_LIMIT=500
NOTIFICATION_TIP_JOB_BATCH_LIMIT=1000
# Secret para POST /notifications/campaigns (header X-Internal-Service-Key)
NOTIFICATIONS_INTERNAL_SERVICE_KEY=
# Cron expressions (@nestjs/schedule)
ABANDONED_CONVERSATIONS_CRON=0 */6 * * *
EDUCATIONAL_TIPS_CRON=0 10 * * 1
