# Supabase Postgres (Prisma)

# Transaction pooler (porta 6543) — uso normal da API com pgbouncer

DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"



# Session pooler (porta 5432) — migrations e operações que exigem sessão direta

DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"



# Firebase Admin (validação de tokens)

FIREBASE_PROJECT_ID=conecta-geracao

# Opcional: caminho para service account JSON (local/prod)

GOOGLE_APPLICATION_CREDENTIALS=



# Gemini (bolt 005 — assistente RAG)

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.0-flash



# Maps / OSM (bolt 011 — proxy Overpass, Nominatim, OSRM)

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

OSRM_BASE_URL=https://router.project-osrm.org

MAPS_HTTP_TIMEOUT_MS=25000

MAPS_DEFAULT_RADIUS_KM=5

MAPS_MAX_RADIUS_KM=10

