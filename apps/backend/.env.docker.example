# Copie para .env antes de subir o Docker:
#   cp .env.docker.example .env
#
# Ou reutilize o mesmo .env do dev local (pnpm api:dev).

PORT=3000

# Supabase Postgres (Prisma) — valores locais; não commitar (ver .gitignore)

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres:senha@6543/postgres"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres:senha@5432/postgres"

# Shadow database for prisma migrate dev (session mode)
SHADOW_DATABASE_URL="postgresql://postgres:senha@5432/postgres"

FIREBASE_PROJECT_ID=conecta-geracao

GEMINI_API_KEY=API_KEY_GEMINI

# Firebase Admin — monte o JSON no docker-compose se necessário
FIREBASE_PROJECT_ID=conecta-geracao

# Gemini (obrigatório — a API não sobe sem GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
